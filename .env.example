# Banco Postgres (Neon). Use a URL com pooling.
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Acesso. As duas senhas precisam ser diferentes; sem elas, ninguém entra.
SENHA_EQUIPE=
SENHA_DONO=
# 32+ caracteres aleatórios (ex.: openssl rand -base64 48)
SEGREDO_SESSAO=

# IA do dono (opcional; sem a chave, os cards ficam com o resumo local).
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
